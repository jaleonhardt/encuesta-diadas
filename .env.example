# Copie este archivo como .env para desarrollo local. En Railway, estas variables se definen en el servicio.
# Nunca suba el archivo .env al repositorio.

DATABASE_URL=postgresql://usuario:clave@localhost:5432/diadas

# Firma de las sesiones. Genere una con: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Clave de cifrado de los datos sensibles (32 bytes en base64).
# Genere una con: python -c "import os,base64; print(base64.b64encode(os.urandom(32)).decode())"
# IMPORTANTE: si esta clave se pierde, los domicilios, polígonos, firmas y audios guardados no se pueden recuperar.
DATA_ENCRYPTION_KEY=

ADMIN_EMAIL=jaleonhardt@uc.cl
ADMIN_PASSWORD=
NOTIFY_EMAIL=jaleonhardt@uc.cl

MAPBOX_TOKEN=
RESEND_API_KEY=
EMAIL_FROM=Encuesta de Díadas <onboarding@resend.dev>

# Dirección pública de la aplicación (para el enlace de los correos)
APP_URL=
TARGET_N=100
